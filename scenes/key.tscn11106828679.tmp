[sub_resource type="GDScript" id="GDScript_ndie3"]
script/source = "extends Area2D

@export var nome_do_item: String = \"chave_misteriosa\"

func _ready() -> void:
	# Garante que a chave está no grupo correto
	add_to_group(\"chaves\")

func ser_coletada() -> void:
	print(\"Chave \", nome_do_item, \" foi deletada do mapa.\")
	
	# Avisa a porta automática (se estiver usando o Eventos.gd)
	if has_node(\"/root/Eventos\"):
		get_node(\"/root/Eventos\").chave_coletada.emit(nome_do_item)
"

